	SECTION "Test",CODE

	; `EXG T,r8` ($12-$17) is out of the ISA, so every form that used it to
	; reach a byte register refuses whether or not synthesis is enabled: byte
	; ALU whose destination is B..L, byte doubling, and NEG/NOT on a byte other
	; than F. Spell them as moves (`ld t,b` / `add t,e` / `ld b,t`) or as a
	; pair exchange (`exg ft,bc` / `add t,c` / `exg ft,bc`). `exg f,t` ($10)
	; and the 16-bit exchanges still assemble.

	exg	b
	exg	c
	exg	t,b
	exg	b,c
	exg	b,f
	exg	f,b

